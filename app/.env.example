# Escolha somente um provedor: iara ou openai.
# Para a branch indev-iara, o caminho recomendado é Iara.
INDEV_LLM_PROVIDER=iara

# Iara: nunca versione valores reais. Obtenha as credenciais e os ACLs no portal Iara.
IARA_CLIENT_ID=
IARA_CLIENT_SECRET=
# Opcional: token Fernet/chave de acesso do portal Iara para ACLs que o exigem.
IARA_ACCESS_TOKEN=
IARA_ENVIRONMENT=homol
IARA_PROVIDER=azure_openai
IARA_MODEL=gpt-4.1-mini
IARA_MODELS=gpt-4.1-mini,gpt-4.1
IARA_MASSIVA_MODEL=gpt-4.1-mini

# Porta local do adaptador. O token é gerado automaticamente a cada execução.
INDEV_IARA_PROXY_PORT=4510
# Opcional: caminho absoluto de um Python 3.9+ que já contenha o SDK Iara.
INDEV_IARA_PYTHON=
# Opcional: certificado PEM da autoridade certificadora corporativa.
IARA_CA_BUNDLE=

# Alternativa OpenAI: mude INDEV_LLM_PROVIDER para openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_MASSIVA_MODEL=gpt-5.6-luna
